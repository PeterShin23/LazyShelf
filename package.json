{
  "name": "LazyShelf",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/PeterShin23/LazyShelf.git",
  "author": "PeterShin23 <pss9fp@virginia.edu>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "monorepo/*"
  ],
  "scripts": {
    "start-fe": "npm --prefix monorepo/frontend start",
    "start-be": "npm --prefix monorepo/backend start:dev",
    "build-fe": "npm --prefix monorepo/frontend run build",
    "build-be": "npm --prefix monorepo/backend run build",
    "build": "npm run build-fe && npm run build-be"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2"
  }
}
